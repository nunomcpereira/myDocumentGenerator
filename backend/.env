# LLM provider: "local" (llama.cpp / any OpenAI-compatible server) or "openai"
LLM_PROVIDER=local

# --- Local / llama.cpp ---
LLM_BASE_URL=http://localhost:8050/v1
LLM_API_KEY=local-llm
LLM_MODEL=llama.cpp
LLM_REQUEST_TIMEOUT_SECONDS=240
LLM_CONNECT_TIMEOUT_SECONDS=10

# --- OpenAI (uncomment and set LLM_PROVIDER=openai above to switch) ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o
# LLM_REQUEST_TIMEOUT_SECONDS=120
# LLM_CONNECT_TIMEOUT_SECONDS=10

# Translation provider configuration
# TRANSLATION_PROVIDER=llm
# TRANSLATION_SOURCE_LANGUAGE=
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
# AZURE_TRANSLATOR_KEY=
# AZURE_TRANSLATOR_REGION=
# GOOGLE_TRANSLATE_API_KEY=